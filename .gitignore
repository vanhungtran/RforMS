# Quarto
/.quarto/
*_cache/
*_files/
**/*.quarto_ipynb

# R
.Rproj.user
.Rhistory
.RData
.Rprofile

# OS
.DS_Store
Thumbs.db

# Generated/book render outputs
# docs/ is the published site and IS tracked — see local-render workflow below.
site_libs/
objects/
ms_data/
figures/
legacy/
MS_basic.html
MS_basic.pdf
MS_basic.tex

# R package library (local installation)
r_libs/

# Book source — rendered locally with `quarto render`, never pushed to GitHub.
# Only docs/ (the compiled output) is public; edit these files locally.
*.qmd
*.Rmd
/custom.scss

# External companion data (not part of the book)
dataMS/

# Archived/legacy files
achieved/

# Data files — never push to GitHub
*.csv
*.xlsx

# AI/planning artifacts — never push to GitHub
.azure/
.codegraph/

# Session/ephemeral files
session_handoff.md
skill.md
skills.md
.claude/

# Rendered book output IS tracked (docs/) even though it can contain
# dir names (*_files/, *_cache/, figures/, site_libs/) that are ignored
# above — those are the site's own required assets. Negations must come
# LAST in this file: git uses the last matching pattern, so these have
# to sit after every rule they need to override.
!docs/**/*_files/
!docs/**/*_files/**
!docs/**/*_cache/
!docs/**/*_cache/**
!docs/**/figures/
!docs/**/figures/**
!docs/**/site_libs/
!docs/**/site_libs/**

# Stray non-book content that ended up under docs/ — never published.
/docs/superpowers/
