Package: RforMS
Type: Package
Title: Reproducible Mass Spectrometry Data Analysis in R
Version: 0.1.0
Date: 2026-10-15
Authors@R: 
  person(
    given = "Lucas VHH",
    family = "Tran",
    role = c("aut", "cre"),
    email = "lucas.tran@ck-care.ch",
    comment = c(affiliation = "CK-CARE Davos")
