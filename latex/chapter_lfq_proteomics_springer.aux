\@writefile{lof}{\contentsline {figure}{\numberline {14.1}{\ignorespaces Empirical density distribution of 4,517 proteins from the 11-site DIA reproducibility benchmark (PXD004886) across normalization strategies. Raw $\log _2$ intensities (left) exhibit systematic multi-site median and scale shifts. Median centering aligns peak profiles across all 11 laboratories while preserving biological dynamic range.}}{5}{figure.caption.2}\protected@file@percent }
\newlabel{fig:norm_density}{{14.1}{5}{Empirical density distribution of 4,517 proteins from the 11-site DIA reproducibility benchmark (PXD004886) across normalization strategies. Raw $\log _2$ intensities (left) exhibit systematic multi-site median and scale shifts. Median centering aligns peak profiles across all 11 laboratories while preserving biological dynamic range}{figure.caption.2}{}}
