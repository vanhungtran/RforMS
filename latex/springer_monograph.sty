\ProvidesPackage{springer_monograph}[2026/10/19 Springer Nature Textbook Monograph Architecture]

% -----------------------------------------------------------------------------
% Springer Nature Textbook Architecture & Typography Style Package
% For "Mass Spectrometry Data Analysis with R"
% Author: Lucas VHH TRAN (CK-CARE Davos, Switzerland)
% -----------------------------------------------------------------------------

\RequirePackage{cmap}
\RequirePackage[margin=1in]{geometry}
\RequirePackage{amsmath,amssymb,amsfonts,amsthm}
\RequirePackage{mathptmx} % Times Roman typography for body and math
\RequirePackage[scaled=0.88]{inconsolata} % Clean monospace code font
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\input{glyphtounicode}
\pdfgentounicode=1
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{colortbl}
\RequirePackage{graphicx}
\RequirePackage{microtype}
\RequirePackage{fancyhdr}
\RequirePackage{listings}
\RequirePackage{upquote}
\RequirePackage{xcolor}
\RequirePackage[many]{tcolorbox}
\tcbuselibrary{listings,skins,breakable}
\RequirePackage{caption}
\RequirePackage{hyperref}

% Define doi macro
\providecommand{\doi}[1]{\href{https://doi.org/#1}{\nolinkurl{doi:#1}}}
\setlength{\headheight}{14.5pt}

% Define abstract environment for book class
\providecommand{\abstractname}{Abstract}
\newenvironment{abstract}{%
  \par\vspace{1em}
  \noindent\textbf{\large\abstractname}\par\vspace{0.5em}
  \itshape\small
}{%
  \par\vspace{1em}
}

% --- Color Palette (Springer Academic Palette) ---
\definecolor{springerNavy}{HTML}{002B49}
\definecolor{springerBlue}{HTML}{005A9C}
\definecolor{springerGray}{HTML}{F8FAFC}
\definecolor{springerBorder}{HTML}{CBD5E1}
\definecolor{codeBg}{HTML}{F8FAFC}
\definecolor{codeFrame}{HTML}{CBD5E1}
\definecolor{codeGreen}{HTML}{15803D}
\definecolor{codeBlue}{HTML}{1D4ED8}
\definecolor{codeGray}{HTML}{64748B}
\definecolor{codeRed}{HTML}{B91C1C}
\definecolor{alertRed}{HTML}{991B1B}
\definecolor{alertBg}{HTML}{FEF2F2}
\definecolor{tipGreen}{HTML}{166534}
\definecolor{tipBg}{HTML}{F0FDF4}
\definecolor{warnAmber}{HTML}{92400E}
\definecolor{warnBg}{HTML}{FFFBEB}
\definecolor{noteBlue}{HTML}{1E40AF}
\definecolor{noteBg}{HTML}{EFF6FF}
\definecolor{deepPurple}{HTML}{5B21B6}
\definecolor{deepBg}{HTML}{F5F3FF}
\definecolor{slateBg}{HTML}{F1F5F9}
\definecolor{slateBorder}{HTML}{94A3B8}

% --- Hyperref Default Configuration ---
\hypersetup{
    colorlinks=true,
    linkcolor=springerBlue,
    citecolor=codeGreen,
    urlcolor=springerBlue
}

% --- R Chunk Listing Counter ---
\newcounter{rchunkcount}[chapter]
\renewcommand{\therchunkcount}{\thechapter.\arabic{rchunkcount}}

% --- Publication-Grade R Code Listing Environment ---
\newtcblisting[use counter=rchunkcount]{rchunk}[2][]{
    enhanced,
    breakable,
    colback=codeBg,
    colframe=springerNavy,
    coltitle=white,
    fonttitle=\bfseries\footnotesize\sffamily,
    title={R Lab Listing \therchunkcount:\enspace #2 \hfill \textsf{\scriptsize[R 4.6 / Bioconductor]}},
    attach boxed title to top left={xshift=4mm, yshift=-2.5mm},
    boxed title style={
        sharp corners=downhill,
        colback=springerNavy,
        colframe=springerNavy,
        arc=1.5mm,
        boxrule=0pt,
        top=2pt, bottom=2pt, left=6pt, right=6pt
    },
    boxrule=0.8pt,
    arc=2mm,
    top=10pt, bottom=6pt, left=6pt, right=6pt,
    listing only,
    listing engine=listings,
    listing options={
        language=R,
        basicstyle=\ttfamily\footnotesize,
        numbers=left,
        numberstyle=\tiny\color{codeGray},
        numbersep=7pt,
        keywordstyle=\color{codeBlue}\bfseries,
        commentstyle=\color{codeGray}\itshape,
        stringstyle=\color{codeGreen},
        breaklines=true,
        breakatwhitespace=true,
        showstringspaces=false,
        tabsize=2,
        columns=flexible,
        keepspaces=true,
        upquote=true,
        literate={~}{{\textasciitilde}}1
    },
    borderline west={3pt}{0pt}{springerNavy},
    #1
}

% --- Styled Console Output Environment ---
\newtcolorbox{routput}[1][]{
    enhanced,
    breakable,
    colback=slateBg,
    colframe=slateBorder,
    boxrule=0.5pt,
    arc=1.5mm,
    top=5pt, bottom=5pt, left=8pt, right=8pt,
    fontupper=\ttfamily\footnotesize\color{black},
    borderline west={2.5pt}{0pt}{codeGray},
    #1
}

